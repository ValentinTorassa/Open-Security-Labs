---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabLayout from "../../components/LabLayout.astro";
import { AUTHOR_JSONLD, LICENSE_URL, SITE_URL } from "../../data/site";
import { getPath } from "../../data/paths";
import { LEVEL_LABELS } from "../../data/levels";
import { isoDate } from "../../data/labs";
import { existsSync } from "node:fs";
import { join } from "node:path";

export const getStaticPaths = (async () => {
  const labs = await getCollection("labs", ({ data }) => !data.draft);

  // Validación en build: cada id de `nextLabs` tiene que existir (y no ser draft).
  // Un typo rompe el build acá en vez de quedar como un link muerto silencioso.
  const ids = new Set(labs.map((l) => l.id));
  const broken = labs.flatMap((l) =>
    l.data.nextLabs
      .filter((id) => !ids.has(id))
      .map((id) => `  - "${l.id}" → nextLabs: "${id}" no existe`),
  );
  if (broken.length > 0) {
    throw new Error(
      `nextLabs apunta a labs inexistentes (o en draft):\n${broken.join("\n")}`,
    );
  }

  // Validación en build: un lab con `environment` tiene su carpeta en
  // entornos/ con los cuatro archivos de la convención (ver entornos/README.md).
  const ENV_FILES = ["Containerfile", "README.md", "check.sh", "solucion.sh"];
  const missingEnv = labs.flatMap((l) =>
    l.data.environment
      ? ENV_FILES.filter(
          (f) => !existsSync(join(process.cwd(), "entornos", l.id, f)),
        ).map((f) => `  - "${l.id}" → falta entornos/${l.id}/${f}`)
      : [],
  );
  if (missingEnv.length > 0) {
    throw new Error(
      `environment sin su carpeta completa:\n${missingEnv.join("\n")}`,
    );
  }

  return labs.map((lab) => ({
    params: { slug: lab.id },
    props: { lab },
  }));
}) satisfies GetStaticPaths;

const { lab } = Astro.props;
const { Content } = await render(lab);

const site = Astro.site ?? new URL(SITE_URL);
const path = getPath(lab.data.path);
const labUrl = new URL(`/labs/${lab.id}/`, site).href;
const routeUrl = path ? new URL(`/rutas/${path.slug}/`, site).href : undefined;
// LearningResource (lo que es un lab) + TechArticle (para que siga siendo
// elegible como artículo). Todo sale del frontmatter; nada se inventa.
const labJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": ["LearningResource", "TechArticle"],
    "@id": `${labUrl}#lab`,
    name: lab.data.title,
    headline: lab.data.title,
    description: lab.data.description,
    inLanguage: "es",
    url: labUrl,
    image: new URL(`/og/${lab.id}.png`, site).href,
    keywords: lab.data.tags.join(", "),
    educationalLevel: LEVEL_LABELS[lab.data.level],
    timeRequired: `PT${lab.data.estimatedMinutes}M`,
    ...(lab.data.objectives.length > 0 ? { teaches: lab.data.objectives } : {}),
    ...(lab.data.prerequisites.length > 0
      ? { competencyRequired: lab.data.prerequisites }
      : {}),
    ...(lab.data.published
      ? { datePublished: isoDate(lab.data.published) }
      : {}),
    ...(lab.data.updated ? { dateModified: isoDate(lab.data.updated) } : {}),
    isAccessibleForFree: true,
    license: LICENSE_URL,
    author: AUTHOR_JSONLD,
    publisher: {
      "@type": "Organization",
      name: "Open Security Labs",
      url: site.href,
    },
    ...(path && routeUrl
      ? {
          isPartOf: {
            "@type": "Course",
            "@id": `${routeUrl}#course`,
            name: path.title,
            url: routeUrl,
          },
        }
      : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Labs",
        item: new URL("/labs/", site).href,
      },
      ...(path && routeUrl
        ? [
            {
              "@type": "ListItem",
              position: 2,
              name: path.title,
              item: routeUrl,
            },
          ]
        : []),
      {
        "@type": "ListItem",
        position: path ? 3 : 2,
        name: lab.data.title,
        item: labUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={lab.data.title}
  description={lab.data.description}
  image={`/og/${lab.id}.png`}
  ogType="article"
  jsonLd={labJsonLd}
  markdown={`/labs/${lab.id}.md`}
  width="prose"
>
  <LabLayout lab={lab}>
    <Content />
  </LabLayout>
</BaseLayout>
