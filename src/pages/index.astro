---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PathCard from "../components/PathCard.astro";
import CertCard from "../components/CertCard.astro";
import Agradecimientos from "../components/Agradecimientos.astro";
import { paths } from "../data/paths";
import { portfolioProjects } from "../data/portfolio";
import { REPO_URL } from "../data/site";
import { sortLabs } from "../data/labs";
import vtAvatar from "../assets/community/vt-avatar.png";

const certifications = (await getCollection("certifications"))
  .map((c) => c.data)
  .sort((a, b) => a.order - b.order);

const labs = sortLabs(await getCollection("labs", ({ data }) => !data.draft));
const labsFor = (slug: string) => labs.filter((l) => l.data.path === slug);
const sortedLabs = labs;
const firstLab =
  sortedLabs.find((l) => l.data.level === "beginner") ?? sortedLabs[0];
const firstLabHref = firstLab ? `/labs/${firstLab.id}/` : "/labs/";
const allLabIds = sortedLabs.map((l) => l.id);
const portfolioTeaser = portfolioProjects.slice(0, 3);

// Pasos del método (la 4ª, "evidencia", en dorado).
const method = [
  {
    icon: "file-text" as const,
    step: "01_",
    title: "Leés",
    body: "La lección explica el mecanismo de fondo, no recetas para copiar y pegar.",
    accent: "var(--color-term-green)",
  },
  {
    icon: "terminal" as const,
    step: "02_",
    title: "Corrés comandos",
    body: "En tu propia máquina, Linux o WSL. Rompés cosas en un entorno seguro.",
    accent: "var(--color-term-green)",
  },
  {
    icon: "flag" as const,
    step: "03_",
    title: "Completás el reto",
    body: "Un enunciado final que te obliga a aplicar lo que entendiste, no a repetir.",
    accent: "var(--color-term-green)",
  },
  {
    icon: "check" as const,
    step: "04_",
    title: "Dejás evidencia",
    body: "Comandos, writeups, diagramas, screenshots, repos. La prueba de que lo hiciste.",
    accent: "var(--color-term-amber)",
  },
];

const audience = [
  {
    icon: "lightbulb" as const,
    title: "Estudiantes y juniors",
    body: "Entrando a ciberseguridad o IT, sin promesas de bootcamp ni atajos.",
  },
  {
    icon: "git-branch" as const,
    title: "Programadores y backend devs",
    body: "Que quieren entender por qué algo falla en producción y no solo en localhost.",
  },
  {
    icon: "server" as const,
    title: "Gente de infra, DevOps y cloud",
    body: "Que quiere dejar de tratar la nube como magia y saber qué pasa por debajo.",
  },
  {
    icon: "bug" as const,
    title: "Curiosos del bajo nivel",
    body: "Que prefieren entender el mecanismo antes que coleccionar herramientas.",
  },
];

const trust = [
  {
    icon: "git-branch" as const,
    title: "Open source",
    body: "El contenido y el código se pueden revisar, discutir y mejorar por Pull Request.",
  },
  {
    icon: "lock" as const,
    title: "Sin cuenta",
    body: "Tu progreso vive en tu navegador. No hay login, backend ni tracking de usuario.",
  },
  {
    icon: "lightbulb" as const,
    title: "Entender de verdad",
    body: "Labs para entender qué pasa por debajo: procesos, red, permisos, HTTP, IAM y logs.",
  },
];

const youtube = "https://www.youtube.com/@vtcibersecurity";
const discord = "https://discord.com/invite/z6cr5JF6bJ";
---

<BaseLayout title="Open Security Labs" width="wide">
  <script is:inline>
    (() => {
      let style = "current";
      try {
        if (localStorage.getItem("osl:home-style-v1") === "archive") {
          style = "archive";
        }
      } catch {}
      document.documentElement.dataset.homeStyle = style;
    })();
  </script>

  <!-- Grilla ambiental + glow radial verde detrás del hero (decorativos). -->
  <div
    class="bg-grid pointer-events-none fixed inset-0 -z-10"
    style="mask-image:radial-gradient(ellipse 80% 60% at 50% 0%, #000 30%, transparent 78%); -webkit-mask-image:radial-gradient(ellipse 80% 60% at 50% 0%, #000 30%, transparent 78%);"
    aria-hidden="true"
  >
  </div>

  <!-- ===================== HERO ===================== -->
  <section
    id="top"
    class="hero-frame mt-4 grid items-center gap-8 px-4 py-5 sm:mt-6 sm:px-6 sm:py-7 lg:grid-cols-[1.02fr_0.98fr] lg:px-8 lg:py-8"
  >
    <div>
      <h1
        class="text-base-50 font-mono text-4xl leading-[1.04] font-extrabold tracking-[-0.04em] sm:text-5xl lg:text-[3.6rem]"
      >
        Aprendé sistemas<br /><span class="text-term-green">de verdad.</span>
      </h1>

      <p class="text-base-300 mt-6 max-w-lg text-lg leading-relaxed">
        Labs prácticos de Linux, redes, backend, cloud y ciberseguridad. Leés,
        corrés comandos en tu máquina y dejás <span class="text-base-100"
          >evidencia</span
        >. Sin hype, sin promesas de bootcamp.
      </p>

      <div class="mt-6 flex flex-wrap gap-2 font-mono text-[0.7rem]">
        <span class="hero-token">open source</span>
        <span class="hero-token">educational labs</span>
        <span class="hero-token">systems-first</span>
        <span class="hero-token">community-built</span>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href={firstLabHref} class="btn-primary">
          <span class="opacity-60">$</span> empezar primer lab
        </a>
      </div>

      <div
        class="text-base-400 mt-8 flex flex-wrap gap-x-7 gap-y-3 font-mono text-xs"
      >
        <span><span class="text-term-green">0{paths.length}</span> rutas</span>
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-term-green transition-colors"
        >
          <span class="text-term-green">100%</span> open source ↗
        </a>
        <span
          ><span class="text-term-green">0</span> login · progreso local</span
        >
        <a
          href="/perfil/"
          data-global-progress
          data-all-ids={allLabIds.join(",")}
          class="hover:text-term-green hidden"
        >
          <span class="text-term-green" data-global-progress-text></span> tu progreso
          →
        </a>
      </div>
    </div>

    <!-- La vista actual usa terminal; Archivo operativo muestra un mapa. -->
    <div class="terminal-object overflow-hidden rounded-xl">
      <div
        class="terminal-object__header border-base-700 flex items-center justify-between gap-4 border-b px-3.5 py-3"
      >
        <span class="text-base-400 font-mono text-xs">open@labs: ~/rutas</span>
        <span
          class="text-base-500 hidden font-mono text-[0.68rem] tracking-[0.14em] uppercase sm:inline"
          >read → run → prove</span
        >
      </div>
      <div
        class="terminal-object__body text-base-200 px-4 py-5 font-mono text-[13.5px] leading-[1.85]"
      >
        <div>
          <span class="text-term-green">open@labs</span><span
            class="text-base-400">:~$</span
          > whoami
        </div>
        <div class="text-base-300 pt-0.5 pb-2">
          &gt; No podés defender sistemas que no entendés cómo funcionan.
        </div>
        <div>
          <span class="text-term-green">open@labs</span><span
            class="text-base-400">:~$</span
          > ls rutas/
        </div>
        <div class="text-term-blue grid grid-cols-2 gap-x-3.5 pt-0.5 pb-2">
          {
            paths.map((p) => (
              <a
                href={`/rutas/${p.slug}/`}
                class="hover:text-term-green w-fit transition-colors hover:underline"
              >
                {p.slug}/
              </a>
            ))
          }
        </div>
        <div>
          <span class="text-term-green">open@labs</span><span
            class="text-base-400">:~$</span
          > cat metodo.txt
        </div>
        <div class="text-base-300 pt-0.5 pb-2">
          leés → corrés → completás el reto → <span class="text-term-amber"
            >dejás evidencia</span
          >
        </div>
        <div>
          <span class="text-term-green">open@labs</span><span
            class="text-base-400">:~$</span
          > ./empezar.sh<span
            class="bg-term-green ml-0.5 inline-block h-4 w-2 [animation:vtBlink_1s_step-end_infinite] align-[-3px]"
          ></span>
        </div>
      </div>

      <div class="archive-system-map" aria-hidden="true">
        <div class="archive-system-map__header">
          <span>OSL / system map</span>
          <span>index 01—06</span>
        </div>
        <div class="archive-system-map__diagram">
          <svg viewBox="0 0 520 280" role="presentation">
            <g class="archive-system-map__orbits">
              <circle cx="260" cy="140" r="94"></circle>
              <circle cx="260" cy="140" r="58"></circle>
              <path d="M260 140 105 54M260 140 260 30M260 140 415 54"></path>
              <path d="M260 140 105 226M260 140 260 250M260 140 415 226"></path>
            </g>
            <g class="archive-system-map__nodes">
              <circle cx="105" cy="54" r="7"></circle>
              <rect x="253" y="23" width="14" height="14"></rect>
              <circle cx="415" cy="54" r="7"></circle>
              <rect x="98" y="219" width="14" height="14"></rect>
              <circle cx="260" cy="250" r="7"></circle>
              <rect x="408" y="219" width="14" height="14"></rect>
            </g>
            <g class="archive-system-map__core">
              <rect x="226" y="106" width="68" height="68"></rect>
              <rect x="242" y="122" width="36" height="36"></rect>
              <circle cx="260" cy="140" r="5"></circle>
            </g>
          </svg>
        </div>
        <div class="archive-system-map__routes">
          {
            paths.map((path, index) => (
              <span style={`--node-color:${path.accent}`}>
                <b>0{index + 1}</b>
                <em>{path.short}</em>
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TU PROGRESO (solo para quien ya empezó) ======= -->
  <a
    href="/perfil/"
    data-resume
    data-all-ids={allLabIds.join(",")}
    class="card group hidden items-center gap-5 p-5 hover:-translate-y-0.5"
  >
    <div class="min-w-0 flex-1">
      <p class="text-base-400 font-mono text-xs">// seguí donde lo dejaste</p>
      <p class="text-base-100 mt-1 font-mono text-sm">
        Llevás <span class="text-term-green font-semibold" data-resume-text
        ></span> del catálogo
      </p>
      <div
        data-resume-progress
        class="bg-base-800 mt-3 h-1.5 w-full overflow-hidden rounded-full"
        role="progressbar"
        aria-label="Progreso del catálogo"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div
          data-resume-bar
          class="bg-term-green h-full rounded-full transition-[width] duration-500"
          style="width:0%"
        >
        </div>
      </div>
    </div>
    <span
      class="text-term-green shrink-0 font-mono text-sm transition-transform group-hover:translate-x-0.5"
    >
      ver tu perfil →
    </span>
  </a>

  <!-- ===================== CONFIANZA ===================== -->
  <section id="confianza" class="py-8">
    <div class="grid gap-3 sm:grid-cols-3">
      {
        trust.map((item) => (
          <div data-trust-card class="card flex gap-3 p-4">
            <span class="text-term-green mt-0.5 inline-flex shrink-0">
              <Icon name={item.icon} size={19} strokeWidth={1.7} />
            </span>
            <span>
              <span class="text-base-100 block font-mono text-sm font-semibold">
                {item.title}
              </span>
              <span class="text-base-400 mt-1 block text-sm leading-relaxed">
                {item.body}
              </span>
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===================== MÉTODO ===================== -->
  <section id="metodo" class="scroll-mt-20 py-8">
    <div class="mb-2 flex items-baseline gap-3.5">
      <span class="text-term-green font-mono text-sm">// 01</span>
      <span class="section-heading-icon" data-section-icon>
        <Icon name="workflow" size={17} strokeWidth={1.7} />
      </span>
      <h2 class="text-base-50 font-mono text-3xl font-bold tracking-tight">
        Cómo funciona un lab
      </h2>
    </div>
    <p class="text-base-400 mb-10 max-w-2xl text-base leading-relaxed">
      Cada módulo es un lab práctico. No se aprende mirando: se aprende
      rompiendo y arreglando en tu propia máquina.
    </p>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        method.map((m) => (
          <div
            data-method-card
            class="card p-5 hover:-translate-y-1"
            style={`--accent:${m.accent}; ${m.accent.includes("amber") ? "border-color: color-mix(in srgb, var(--color-term-amber) 40%, transparent);" : ""}`}
          >
            <div class="mb-3.5 flex items-center gap-2.5">
              <span style={`color:${m.accent}`} class="inline-flex">
                <Icon name={m.icon} size={21} strokeWidth={1.6} />
              </span>
              <span class="font-mono text-sm" style={`color:${m.accent}`}>
                {m.step}
              </span>
            </div>
            <div class="text-base-100 mb-2 font-mono text-base font-semibold">
              {m.title}
            </div>
            <p class="text-base-400 text-sm leading-relaxed">{m.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===================== RUTAS ===================== -->
  <section id="rutas" class="scroll-mt-20 py-8">
    <div class="mb-2 flex items-baseline gap-3.5">
      <span class="text-term-green font-mono text-sm">// 02</span>
      <span class="section-heading-icon" data-section-icon>
        <Icon name="git-branch" size={17} strokeWidth={1.7} />
      </span>
      <h2 class="text-base-50 font-mono text-3xl font-bold tracking-tight">
        Rutas de aprendizaje
      </h2>
    </div>
    <p class="text-base-400 mb-10 max-w-2xl text-base leading-relaxed">
      Seis caminos que se cruzan. Empezá por donde te haga falta entender mejor.
    </p>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        paths.map((path) => {
          const pathLabs = labsFor(path.slug);
          return (
            <PathCard
              path={path}
              labCount={pathLabs.length}
              labIds={pathLabs.map((l) => l.id)}
            />
          );
        })
      }
    </div>
  </section>

  <!-- ===================== CERTIFICACIONES ===================== -->
  <section id="certificaciones" class="scroll-mt-20 py-8">
    <div class="mb-2 flex items-baseline gap-3.5">
      <span class="text-term-green font-mono text-sm">// 03</span>
      <span class="section-heading-icon" data-section-icon>
        <Icon name="award" size={17} strokeWidth={1.7} />
      </span>
      <h2 class="text-base-50 font-mono text-3xl font-bold tracking-tight">
        Certificaciones
      </h2>
    </div>
    <p class="text-base-400 mb-10 max-w-2xl text-base leading-relaxed">
      Open Security Labs es gratis y no emite títulos propios. Pero te da la <span
        class="text-base-100">base real</span
      > para encarar las certificaciones que el mercado pide — sin estudiar de memoria.
      Cada ruta apunta a una.
    </p>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {certifications.map((cert) => <CertCard cert={cert} />)}
    </div>
    <p class="text-base-500 mt-6 text-xs leading-relaxed">
      Open Security Labs no está afiliado a estas organizaciones; cada logo y
      marca pertenece a su dueño.
    </p>
  </section>

  <!-- ===================== PORTAFOLIO ===================== -->
  <section id="portafolio" class="scroll-mt-20 py-8">
    <div class="mb-2 flex items-baseline gap-3.5">
      <span class="text-term-green font-mono text-sm">// 04</span>
      <span class="section-heading-icon" data-section-icon>
        <Icon name="file-text" size={17} strokeWidth={1.7} />
      </span>
      <h2 class="text-base-50 font-mono text-3xl font-bold tracking-tight">
        Proyectos para portafolio
      </h2>
    </div>
    <p class="text-base-400 mb-8 max-w-2xl text-base leading-relaxed">
      Convertí lo que aprendés en evidencia concreta: repos, writeups,
      diagramas, tests y decisiones técnicas que alguien puede revisar.
    </p>

    <div class="grid gap-5 lg:grid-cols-[1fr_0.92fr] lg:items-start">
      <div class="grid gap-3">
        {
          portfolioTeaser.map((project) => (
            <a
              data-portfolio-project
              href={`/portafolio/#${project.slug}`}
              class="card group flex gap-4 p-4 hover:-translate-y-0.5"
              style={`--accent: ${project.accent}`}
            >
              <span
                class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border"
                style="border-color: color-mix(in srgb, var(--accent) 40%, transparent); color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent)"
              >
                <Icon name={project.icon} size={20} strokeWidth={1.6} />
              </span>
              <span class="min-w-0">
                <span class="font-mono text-xs" style="color: var(--accent)">
                  {project.role}
                </span>
                <span class="text-base-100 mt-1 block font-semibold transition-colors group-hover:text-[color:var(--accent)]">
                  {project.title}
                </span>
                <span class="text-base-400 mt-1 line-clamp-2 block text-sm leading-relaxed">
                  {project.summary}
                </span>
              </span>
            </a>
          ))
        }

        <div class="mt-1 flex flex-wrap gap-3">
          <a href="/portafolio/" class="btn-primary"> ver roadmap completo </a>
        </div>
      </div>

      <div
        data-portfolio-roadmap
        class="border-base-700 bg-base-900 relative overflow-hidden rounded-2xl border p-6 sm:p-7"
      >
        <div
          class="pointer-events-none absolute inset-0 opacity-70"
          style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-base-850) 86%, transparent), transparent 60%);"
          aria-hidden="true"
        >
        </div>
        <div class="relative">
          <p
            class="text-term-green font-mono text-xs tracking-[0.15em] uppercase"
          >
            // roadmap completo
          </p>
          <h3 class="text-base-50 mt-3 font-mono text-2xl font-bold">
            Que tu repo explique cómo pensás.
          </h3>
          <p class="text-base-300 mt-3 max-w-xl leading-relaxed">
            Briefs concretos para transformar labs en proyectos revisables: qué
            construir, cómo documentarlo y qué evidencia dejar.
          </p>

          <div class="mt-6 grid gap-2 font-mono text-xs">
            <div
              class="border-base-800 bg-base-950/35 flex items-center justify-between gap-4 rounded-lg border px-3 py-2"
            >
              <span class="text-base-400">proyectos</span>
              <span class="text-term-green">{portfolioProjects.length}</span>
            </div>
            <div
              class="border-base-800 bg-base-950/35 flex items-center justify-between gap-4 rounded-lg border px-3 py-2"
            >
              <span class="text-base-400">evidencia</span>
              <span class="text-term-amber">repo + writeup</span>
            </div>
            <div
              class="border-base-800 bg-base-950/35 flex items-center justify-between gap-4 rounded-lg border px-3 py-2"
            >
              <span class="text-base-400">formato</span>
              <span class="text-term-blue">brief técnico</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PARA QUIÉN ===================== -->
  <section id="quien" class="scroll-mt-20 py-8">
    <div class="mb-2 flex items-baseline gap-3.5">
      <span class="text-term-green font-mono text-sm">// 05</span>
      <span class="section-heading-icon" data-section-icon>
        <Icon name="target" size={17} strokeWidth={1.7} />
      </span>
      <h2 class="text-base-50 font-mono text-3xl font-bold tracking-tight">
        ¿Para quién es?
      </h2>
    </div>
    <p class="text-base-400 mb-10 max-w-2xl text-base leading-relaxed">
      Para gente que prefiere entender el mecanismo antes que coleccionar
      herramientas.
    </p>

    <div class="grid gap-3.5 sm:grid-cols-2">
      {
        audience.map((a) => (
          <div data-audience-card class="card flex gap-4 p-5">
            <span class="text-term-green mt-0.5 inline-flex shrink-0">
              <Icon name={a.icon} size={22} strokeWidth={1.6} />
            </span>
            <div>
              <div class="text-base-100 mb-1.5 font-mono text-base font-semibold">
                {a.title}
              </div>
              <p class="text-base-400 text-sm leading-relaxed">{a.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===================== AGRADECIMIENTOS ===================== -->
  <Agradecimientos />

  <!-- ===================== COMUNIDAD / CTA ===================== -->
  <section id="comunidad" class="scroll-mt-20 py-8">
    <div
      data-community-panel
      class="border-base-700 bg-base-900 relative overflow-hidden rounded-2xl border p-8 sm:p-11"
    >
      <div
        class="relative grid items-center gap-8 lg:grid-cols-[auto_1fr_auto]"
      >
        <div class="relative shrink-0">
          <Image
            src={vtAvatar}
            alt="VT Security — mascota pingüino con capucha"
            width={124}
            height={124}
            class="border-base-600 block h-[124px] w-[124px] rounded-2xl border bg-black"
          />
          <span
            class="bg-term-green text-base-950 absolute -right-2 -bottom-2 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-xs font-semibold"
          >
            canal
          </span>
        </div>
        <div>
          <div
            class="text-term-green mb-3 flex items-center gap-2.5 font-mono text-xs tracking-[0.15em] uppercase"
          >
            <span class="section-heading-icon" data-section-icon>
              <Icon name="network" size={17} strokeWidth={1.7} />
            </span>
            <span>// comunidad</span>
          </div>
          <h2
            class="text-base-50 mb-3 font-mono text-2xl font-extrabold tracking-tight sm:text-3xl"
          >
            Seguí los labs en VT Security
          </h2>
          <p class="text-base-300 max-w-xl leading-relaxed">
            Ciberseguridad, Linux y home labs explicados de verdad por Valentín
            Torassa Colombero — Rosario, Argentina. Tutoriales prácticos de
            programación, redes y seguridad. Se aprende haciendo, en abierto.
