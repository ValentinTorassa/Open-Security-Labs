---
import type { LearningPath } from "../data/paths";
import Icon from "./Icon.astro";

interface Props {
  path: LearningPath;
  labCount?: number;
  /** Ids de los labs de la ruta, para calcular progreso en el cliente. */
  labIds?: string[];
}
const { path, labCount, labIds = [] } = Astro.props;
---

<a
  href={`/rutas/${path.slug}/`}
  class="card group relative flex flex-col overflow-hidden p-5 hover:-translate-y-0.5"
  style={`--accent: ${path.accent}`}
  data-path-card
  data-path-slug={path.slug}
>
  <div class="flex items-center justify-between gap-3">
    <span
      class="flex h-10 w-10 items-center justify-center rounded-lg border"
      style="border-color: color-mix(in srgb, var(--accent) 40%, transparent); color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent)"
    >
      <span class="path-icon-default flex items-center justify-center">
        <Icon name={path.icon} size={20} />
      </span>
      {
        path.slug === "redes-internet" && (
          <svg
            class="archive-route-art"
            viewBox="0 0 120 120"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            aria-hidden="true"
          >
            <path d="M60 60V24M60 60 25 90m35-30 35 30" opacity="0.65" />
            <circle cx="60" cy="22" r="11" />
            <circle cx="23" cy="92" r="11" />
            <circle cx="97" cy="92" r="11" />
            <circle cx="60" cy="60" r="7" />
            <g fill="currentColor" stroke="none">
              <circle cx="60" cy="22" r="2.4" />
              <circle cx="23" cy="92" r="2.4" />
              <circle cx="97" cy="92" r="2.4" />
              <circle cx="60" cy="60" r="2.8" />
            </g>
          </svg>
        )
      }
      {
        path.slug === "cloud-produccion" && (
          <svg
            class="archive-route-art"
            viewBox="0 0 120 120"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M24 48h66c8 0 14-6 14-13s-6-13-14-13c-2 0-4 .4-6 1C80 14 72 9 62 9c-13 0-23 9-25 21-3-2-6-3-10-3-8 0-14 5-14 11s5 10 11 10Z" />
            <path
              d="M60 48v18M26 66h68M26 66v14m34-14v14m34-14v14"
              opacity="0.7"
            />
            <rect x="14" y="80" width="24" height="22" />
            <rect x="48" y="80" width="24" height="22" />
            <rect x="82" y="80" width="24" height="22" />
            <path
              d="M19 88h10m-10 6h7m27-6h10m-10 6h7m27-6h10m-10 6h7"
              opacity="0.68"
            />
            <g fill="currentColor" stroke="none">
              <circle cx="33" cy="94" r="1.8" />
              <circle cx="67" cy="94" r="1.8" />
              <circle cx="101" cy="94" r="1.8" />
            </g>
          </svg>
        )
      }
      {
        path.slug === "ciberseguridad" && (
          <svg
            class="archive-route-art"
            viewBox="0 0 120 120"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m60 8 44 17v31c0 25-17 43-44 57-27-14-44-32-44-57V25Z" />
            <path d="m40 58 12 12 28-31" stroke-width="2" />
          </svg>
        )
      }
      {
        path.slug === "devsecops-agentes" && (
          <svg
            class="archive-route-art"
            viewBox="0 0 120 120"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M16 60c12-25 29-27 44 0s32 25 44 0c-12-25-29-27-44 0S28 85 16 60Z" />
            <rect
              x="50"
              y="50"
              width="20"
              height="20"
              fill="var(--archive-surface, #0d0e0c)"
            />
            <path d="m55 60 4 4 7-9" stroke-width="1.8" />
          </svg>
        )
      }
    </span>
    <span class="text-base-400 flex items-center gap-2 font-mono text-xs">
      <span>Ruta {String(path.order).padStart(2, "0")}</span>
      {
        typeof labCount === "number" && (
          <>
            <span class="text-base-600">·</span>
            <span>
              {labCount} {labCount === 1 ? "lab" : "labs"}
            </span>
          </>
        )
      }
    </span>
  </div>

  <h3 class="text-base-50 mt-4 text-lg font-semibold transition-colors">
    <span class="group-hover:text-[color:var(--accent)]">{path.title}</span>
  </h3>

  <p class="text-base-300 mt-1.5 text-sm leading-relaxed">{path.tagline}</p>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {
      path.focus
        .slice(0, 4)
        .map((f) => (
          <span class="border-base-700 bg-base-800/60 text-base-400 rounded border px-2 py-0.5 font-mono text-[0.7rem]">
            {f}
          </span>
        ))
    }
  </div>

  <div
    class="border-base-800 mt-4 flex items-center gap-2 border-t pt-3 font-mono text-xs"
  >
    <span style="color: var(--accent)">$</span>
    <span class="text-base-400 truncate">{path.command}</span>
    <span
      class="text-base-500 ml-auto transition-transform group-hover:translate-x-0.5"
      style="color: var(--accent)"
      aria-hidden="true">→</span
    >
  </div>

  {
    labIds.length > 0 && (
      <div
        data-path-progress
        data-lab-ids={labIds.join(",")}
        class="mt-3 hidden"
      >
        <div class="bg-base-800 h-1 w-full overflow-hidden rounded-full">
          <div
            data-path-progress-bar
            class="h-full rounded-full transition-[width] duration-500"
            style="width: 0%; background: var(--accent)"
            role="progressbar"
            aria-label={`Progreso en ${path.title}`}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          />
        </div>
        <p
          data-path-progress-label
          class="text-base-500 mt-1.5 font-mono text-[0.7rem]"
        />
      </div>
    )
  }
</a>

<style>
  .archive-route-art {
    display: none;
  }
</style>

<script>
  import { countDone, onProgress } from "../scripts/progress";

  function hydrate() {
    document
      .querySelectorAll<HTMLElement>("[data-path-progress]")
      .forEach((el) => {
        const ids = (el.dataset.labIds ?? "").split(",").filter(Boolean);
        if (!ids.length) return;
        const done = countDone(ids);
        if (done === 0) {
          el.classList.add("hidden");
          return;
        }
        el.classList.remove("hidden");
        const pct = Math.round((done / ids.length) * 100);
        const bar = el.querySelector<HTMLElement>("[data-path-progress-bar]");
        if (bar) {
          bar.style.width = `${pct}%`;
          bar.setAttribute("aria-valuenow", String(pct));
        }
        const label = el.querySelector<HTMLElement>(
          "[data-path-progress-label]",
        );
        if (label) {
          label.textContent =
            pct === 100
              ? `✓ ruta completada · ${done}/${ids.length}`
              : `${done}/${ids.length} labs · ${pct}%`;
          label.classList.toggle("text-term-green", pct === 100);
        }
      });
  }

  hydrate();
  onProgress(hydrate);
</script>
