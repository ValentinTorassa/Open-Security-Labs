# Entorno: ciberseguridad/sql-injection-parametrizada
# Construilo desde la raíz del repo (el contexto es entornos/):
#   podman build -t osl/sql-injection-parametrizada -f entornos/ciberseguridad/sql-injection-parametrizada/Containerfile entornos
FROM docker.io/library/python:3.13-slim
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends sqlite3 less nano \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 1000 --shell /bin/bash vt

COPY _lib/lab-check /usr/local/bin/lab-check
COPY _lib/lab-check.sh /usr/local/lib/osl/lab-check.sh
COPY _lib/bienvenida.sh /etc/profile.d/osl.sh
COPY ciberseguridad/sql-injection-parametrizada/check.sh /usr/local/lib/osl/check.sh
COPY ciberseguridad/sql-injection-parametrizada/bienvenida.txt /usr/local/lib/osl/bienvenida.txt
COPY ciberseguridad/sql-injection-parametrizada/sqli/ /home/vt/sqli/

RUN chmod 0755 /usr/local/bin/lab-check \
 && cd /home/vt/sqli && sqlite3 usuarios.db < usuarios.sql \
 && chown -R vt:vt /home/vt/sqli

ENV OSL_LAB=ciberseguridad/sql-injection-parametrizada
USER vt
WORKDIR /home/vt/sqli
CMD ["bash", "-l"]
