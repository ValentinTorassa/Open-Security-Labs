# Entorno: redes-internet/tls-sin-magia
# Construilo desde la raíz del repo (el contexto es entornos/):
#   podman build -t osl/tls-sin-magia -f entornos/redes-internet/tls-sin-magia/Containerfile entornos
FROM docker.io/library/debian:trixie-slim
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl curl ca-certificates less procps \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 1000 --shell /bin/bash vt

COPY _lib/lab-check /usr/local/bin/lab-check
COPY _lib/lab-check.sh /usr/local/lib/osl/lab-check.sh
COPY _lib/bienvenida.sh /etc/profile.d/osl.sh
COPY redes-internet/tls-sin-magia/check.sh /usr/local/lib/osl/check.sh
COPY redes-internet/tls-sin-magia/bienvenida.txt /usr/local/lib/osl/bienvenida.txt
COPY redes-internet/tls-sin-magia/certificados.sh /usr/local/lib/osl/certificados.sh
COPY redes-internet/tls-sin-magia/arranque.sh /usr/local/lib/osl/arranque.sh

RUN chmod 0755 /usr/local/bin/lab-check /usr/local/lib/osl/certificados.sh /usr/local/lib/osl/arranque.sh

ENV OSL_LAB=redes-internet/tls-sin-magia
USER vt
WORKDIR /home/vt
ENTRYPOINT ["/usr/local/lib/osl/arranque.sh"]
CMD ["bash", "-l"]
