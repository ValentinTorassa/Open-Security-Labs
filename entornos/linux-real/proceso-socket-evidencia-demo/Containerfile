# Entorno: linux-real/proceso-socket-evidencia-demo
# Construilo desde la raíz del repo (el contexto es entornos/):
#   podman build -t osl/proceso-socket-evidencia-demo -f entornos/linux-real/proceso-socket-evidencia-demo/Containerfile entornos
#
# Los procesos y sockets son reales, pero viven en la red aislada del
# contenedor: no inspeccionás tu equipo ni hay tráfico hacia afuera.
FROM docker.io/library/debian:trixie-slim
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends iproute2 less procps python3-minimal \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 1000 --shell /bin/bash vt

COPY _lib/lab-check /usr/local/bin/lab-check
COPY _lib/lab-check.sh /usr/local/lib/osl/lab-check.sh
COPY _lib/bienvenida.sh /etc/profile.d/osl.sh
COPY linux-real/proceso-socket-evidencia-demo/check.sh /usr/local/lib/osl/check.sh
COPY linux-real/proceso-socket-evidencia-demo/bienvenida.txt /usr/local/lib/osl/bienvenida.txt
COPY linux-real/proceso-socket-evidencia-demo/juguete.py /usr/local/lib/osl/juguete.py
COPY linux-real/proceso-socket-evidencia-demo/arranque.sh /usr/local/lib/osl/arranque.sh

RUN chmod 0755 /usr/local/bin/lab-check /usr/local/lib/osl/arranque.sh

ENV OSL_LAB=linux-real/proceso-socket-evidencia-demo
USER vt
WORKDIR /home/vt
ENTRYPOINT ["/usr/local/lib/osl/arranque.sh"]
CMD ["bash", "-l"]
